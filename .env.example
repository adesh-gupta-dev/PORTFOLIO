# Server-only variables. Never prefix these with VITE_. Do not commit real values.
ADMIN_USERNAME=change-me
# At least 8 characters; a unique random password of 16+ characters is recommended.
ADMIN_PASSWORD=
# At least 32 characters. Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
ADMIN_ORIGIN=https://adeshgupta.site
# Fine-grained GitHub token limited to this repository, Contents: read and write.
GITHUB_CONTENT_TOKEN=
GITHUB_REPOSITORY=adesh-gupta-dev/PORTFOLIO
# Set to the branch connected to your existing Vercel production deployment.
GITHUB_BRANCH=main

# Public build-time analytics setting (not a secret). Blank disables GTM.
VITE_GTM_ID=
